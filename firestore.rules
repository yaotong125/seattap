rules_version = '2';

// SeatTap — Sprint 1 slice: accounts, registration/approval, profiles, role dashboards.
//
// Runs on the free Spark plan, so there are no Cloud Functions: these rules are the
// backend. A user's role comes from their own profile (users/{uid}.role, with status
// 'active'), and these rules decide which profiles may be created:
//   - a verified UTM email that is on the Exam Office roster (directory/{email}) gets
//     exactly the role and ID number on the roster, status 'active';
//   - a verified @utm.my email that is not on the roster may only register as a
//     'pending' invigilator, until an Exam Officer approves or rejects it.
// Collections for exams, halls and check-ins are added in the sprints that build them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isStudentEmail(email) {
      return email.matches('[^@]+@graduate[.]utm[.]my');
    }

    function isStaffEmail(email) {
      return email.matches('[^@]+@utm[.]my');
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function directoryPath(email) {
      return /databases/$(database)/documents/directory/$(email);
    }

    // The caller's active role, read from their own profile.
    function hasActiveRole(role) {
      return signedIn()
          && exists(profilePath(request.auth.uid))
          && get(profilePath(request.auth.uid)).data.status == 'active'
          && get(profilePath(request.auth.uid)).data.role == role;
    }

    function isExamOfficer() {
      return hasActiveRole('examOfficer');
    }

    function isValidRole(role) {
      return role in ['student', 'invigilator', 'examOfficer'];
    }

    // Students use @graduate.utm.my; invigilators and Exam Officers use @utm.my.
    function roleFitsEmail(role, email) {
      return (role == 'student' && isStudentEmail(email))
          || (role in ['invigilator', 'examOfficer'] && isStaffEmail(email));
    }

    function isValidId(role, idNumber) {
      return idNumber is string
          && (role == 'student'
                ? idNumber.matches('[A-Z][0-9]{2}[A-Z]{2}[0-9]{4}')
                : idNumber.matches('[A-Z0-9-]{3,20}'));
    }

    function optionalText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // A small profile picture stored in the profile itself (no Cloud Storage on Spark).
    function validPhoto(d) {
      return !('photoUrl' in d)
          || (d.photoUrl is string
              && d.photoUrl.size() <= 200000
              && d.photoUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }

    // Registration (Complete profile screen): the profile must agree with the roster.
    function validRegistration(uid) {
      let d = request.resource.data;
      let email = myEmail();
      let listed = exists(directoryPath(email));
      return verified()
          && d.keys().hasAll(['email', 'name', 'idNumber', 'role', 'status', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['email', 'name', 'idNumber', 'role', 'status', 'phone', 'faculty',
                               'photoUrl', 'createdAt', 'updatedAt'])
          && d.email == email
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && optionalText(d, 'phone', 20)
          && optionalText(d, 'faculty', 80)
          && validPhoto(d)
          && d.createdAt == request.time
          && d.updatedAt == request.time
          && isValidId(d.role, d.idNumber)
          && roleFitsEmail(d.role, email)
          && (listed
                // On the roster: exactly the roster's role and ID, active straight away.
                ? (d.role == get(directoryPath(email)).data.role
                   && d.idNumber == get(directoryPath(email)).data.idNumber
                   && d.status == 'active')
                // Not on the roster: UTM staff wait for an Exam Officer; students cannot register.
                : (d.role == 'invigilator' && d.status == 'pending'));
    }

    // Edit Profile screen. email, idNumber, role and status belong to the Exam Office.
    function validProfileEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'faculty', 'photoUrl', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && optionalText(d, 'phone', 20)
          && optionalText(d, 'faculty', 80)
          && validPhoto(d)
          && d.updatedAt == request.time;
    }

    // Pending staff approvals screen: an Exam Officer approves or rejects, once.
    function validReview() {
      let d = request.resource.data;
      return resource.data.status == 'pending'
          && resource.data.role == 'invigilator'
          && d.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
          && d.status in ['active', 'rejected']
          && d.reviewedBy == request.auth.uid
          && d.reviewedAt == request.time
          && d.updatedAt == request.time;
    }

    function validDirectoryEntry(email) {
      let d = request.resource.data;
      return d.keys().hasAll(['email', 'idNumber', 'name', 'role'])
          && d.keys().hasOnly(['email', 'idNumber', 'name', 'role', 'faculty', 'addedBy', 'addedAt'])
          && d.email == email
          && email == email.lower()
          && isValidRole(d.role)
          && roleFitsEmail(d.role, email)
          && isValidId(d.role, d.idNumber)
          && d.name is string && d.name.size() <= 80
          && optionalText(d, 'faculty', 80)
          && d.addedBy == request.auth.uid
          && d.addedAt == request.time;
    }

    // users/{uid} — one profile per account.
    match /users/{uid} {
      // Own profile; Exam Officers can read everyone (pending approvals, dashboard counts).
      allow get: if isSelf(uid) || isExamOfficer();
      allow list: if isExamOfficer();
      allow create: if isSelf(uid) && validRegistration(uid);
      allow update: if (isSelf(uid) && validProfileEdit())
                    || (isExamOfficer() && validReview());
      allow delete: if false;
    }

    // directory/{email} — the Exam Office roster of students and staff.
    // A verified user may read only their own entry (to fill in their role at sign-up);
    // Exam Officers manage the roster.
    match /directory/{email} {
      allow get: if (verified() && myEmail() == email) || isExamOfficer();
      allow list: if isExamOfficer();
      allow create, update: if isExamOfficer() && validDirectoryEntry(email);
      allow delete: if isExamOfficer();
    }

    // Everything else is closed until a sprint opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
